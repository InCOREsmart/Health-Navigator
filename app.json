{
  "expo": {
    "name": "Health Navigator",
    "slug": "health-navigator",
    "version": "0.2.1",
    "orientation": "portrait",
    "scheme": "healthnavigator",
    "userInterfaceStyle": "automatic",
    "web": {
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "expo-image-picker",
      "expo-audio",
      "expo-speech-recognition",
      "react-native-health-connect"
    ],
    "android": {
      "permissions": ["android.permission.CAMERA", "android.permission.RECORD_AUDIO", "android.permission.ACTIVITY_RECOGNITION"],
      "package": "com.incore.healthnavigator"
    },
    "ios": {
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Health Navigator использует микрофон для ввода симптомов голосом.",
        "NSSpeechRecognitionUsageDescription": "Health Navigator преобразует вашу речь в текст для оценки состояния."
      }
    },
    "experiments": {
      "typedRoutes": true
    }
  }
}
